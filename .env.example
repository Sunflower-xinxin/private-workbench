# Server-only values. Do not expose these in config.js or commit real values.
PORT=8797
HOST=0.0.0.0
WORKBENCH_DATA_DIR=/var/lib/private-workbench
WORKBENCH_ADMIN_EMAIL=you@example.com
WORKBENCH_ADMIN_PASSWORD=replace-with-a-long-unique-password
WORKBENCH_SESSION_SECRET=replace-with-at-least-32-random-characters

# Only needed when the PWA and API are hosted on different origins.
# Comma-separated, exact origins; example: https://your-name.github.io
WORKBENCH_ALLOWED_ORIGINS=
